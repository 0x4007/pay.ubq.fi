      {
        "id": 2338786454,
        "content": "What I see is that we are probably going to introduce the virtual card feature before the rollup feature.",
        "url": "https://github.com/ubiquity/pay.ubq.fi/issues/291#issuecomment-2338786454",
        "commentType": "ISSUE_AUTHOR",
        "score": {
